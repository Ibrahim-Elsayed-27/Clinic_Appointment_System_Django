pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_TAG', description: 'Image tag already validated in dev — required, no default')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Confirm promotion') {
            steps {
                input message: "Deploy build ${params.IMAGE_TAG} to PRODUCTION? Confirm this tag has been validated in dev."
            }
        }

        stage('Deploy to prod') {
            steps {
                sh '''
                    set -euo pipefail

                    DB_SECRET_JSON=$(aws secretsmanager get-secret-value \
                      --secret-id "clinic/db-credentials-prod" \
                      --query SecretString --output text)

                    DB_USER=$(echo "$DB_SECRET_JSON" | jq -r .username)
                    DB_PASSWORD=$(echo "$DB_SECRET_JSON" | jq -r .password)
                    DB_NAME=$(echo "$DB_SECRET_JSON" | jq -r .dbname)

                    DJANGO_SECRET_KEY=$(aws secretsmanager get-secret-value \
                      --secret-id "clinic/django-secret-key-prod" \
                      --query SecretString --output text)

                    EFS_ID=$(aws efs describe-file-systems \
                      --query "FileSystems[?Tags[?Key=='Name' && Value=='prod-clinic-media']].FileSystemId" \
                      --output text)

                    DB_HOST=$(aws rds describe-db-instances \
                      --db-instance-identifier "prod-clinic-db" \
                      --query "DBInstances[0].Endpoint.Address" --output text)

                    # Try to discover the ingress/nginx controller DNS so we can add it
                    # to allowed hosts and CSRF trusted origins in Helm values.
                    # Fall back gracefully if kubectl isn't available or the svc has no LB yet.
                    NGINX_CONTROLLER_DNS=$(kubectl get svc ingress-nginx-controller -n ingress-nginx \
                      -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || \
                      kubectl get svc ingress-nginx-controller -n ingress-nginx -o jsonpath='{.status.loadBalancer.ingress[0].ip}' 2>/dev/null || true)

                    umask 077
                    VALUES_FILE=$(mktemp /tmp/clinic-secrets-XXXXXX.yaml)
                    trap 'rm -f "$VALUES_FILE"' EXIT

                    cat > "$VALUES_FILE" <<EOF
database:
  user: "${DB_USER}"
  password: "${DB_PASSWORD}"
  name: "${DB_NAME}"
  host: "${DB_HOST}"
django:
  secretKey: "${DJANGO_SECRET_KEY}"
  allowedHosts:
    - "${NGINX_CONTROLLER_DNS}"
  csrfTrustedOrigins:
    - "https://${NGINX_CONTROLLER_DNS}"
efs:
  fileSystemId: "${EFS_ID}"
image:
  tag: "${IMAGE_TAG}"
nginx:
  image:
    tag: "${IMAGE_TAG}"
EOF

                    helm upgrade --install clinic ./helm/clinic \
                      -f ./helm/clinic/values.yaml \
                      -f ./helm/clinic/values-prod.yaml \
                      -f "$VALUES_FILE" \
                      --namespace prod \
                      --create-namespace

                    unset DB_USER DB_PASSWORD DB_NAME DJANGO_SECRET_KEY DB_SECRET_JSON
                '''
            }
        }
    }
}