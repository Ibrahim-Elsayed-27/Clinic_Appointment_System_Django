pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Image tag built by CI')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Deploy to dev') {
            steps {
                script { deployToEnv('dev') }
            }
        }

        stage('Approval for prod') {
            steps {
                input message: "Deploy build ${params.IMAGE_TAG} to PRODUCTION?"
            }
        }

        stage('Deploy to prod') {
            steps {
                script { deployToEnv('prod') }
            }
        }
    }
}

def deployToEnv(targetEnv) {
    withEnv(["TARGET_ENV=${targetEnv}", "IMAGE_TAG=${params.IMAGE_TAG}"]) {
        sh '''
            set -euo pipefail

            DB_SECRET_JSON=$(aws secretsmanager get-secret-value \
              --secret-id "clinic/db-credentials-${TARGET_ENV}" \
              --query SecretString --output text)

            DB_USER=$(echo "$DB_SECRET_JSON" | jq -r .username)
            DB_PASSWORD=$(echo "$DB_SECRET_JSON" | jq -r .password)
            DB_NAME=$(echo "$DB_SECRET_JSON" | jq -r .dbname)

            DJANGO_SECRET_KEY=$(aws secretsmanager get-secret-value \
              --secret-id "clinic/django-secret-key-${TARGET_ENV}" \
              --query SecretString --output text)

            EFS_ID=$(aws efs describe-file-systems \
              --query "FileSystems[?Tags[?Key=='Name' && Value=='${TARGET_ENV}-clinic-media']].FileSystemId" \
              --output text)

            DB_HOST=""
            if [ "$TARGET_ENV" = "prod" ]; then
              DB_HOST=$(aws rds describe-db-instances \
                --db-instance-identifier "${TARGET_ENV}-clinic-db" \
                --query "DBInstances[0].Endpoint.Address" --output text)
            fi

            umask 077
            VALUES_FILE=$(mktemp /tmp/clinic-secrets-XXXXXX.yaml)
            trap 'rm -f "$VALUES_FILE"' EXIT

            cat > "$VALUES_FILE" <<EOF
database:
  user: "${DB_USER}"
  password: "${DB_PASSWORD}"
  name: "${DB_NAME}"
  host: "${DB_HOST}"
django:
  secretKey: "${DJANGO_SECRET_KEY}"
efs:
  fileSystemId: "${EFS_ID}"
image:
  tag: "${IMAGE_TAG}"
nginx:
  image:
    tag: "${IMAGE_TAG}"
EOF

            helm upgrade --install clinic ./helm/clinic \
              -f ./helm/clinic/values.yaml \
              -f "./helm/clinic/values-${TARGET_ENV}.yaml" \
              -f "$VALUES_FILE" \
              --namespace "${TARGET_ENV}" \
              --create-namespace

            unset DB_USER DB_PASSWORD DB_NAME DJANGO_SECRET_KEY DB_SECRET_JSON
        '''
    }
}