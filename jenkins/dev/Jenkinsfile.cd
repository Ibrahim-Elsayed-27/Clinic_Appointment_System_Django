pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Image tag to deploy')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Deploy monitoring') {
            steps {
                sh '''
                    set -euo pipefail
                    export KUBECONFIG=/var/lib/jenkins/.kube/config

                    GRAFANA_PASSWORD=$(aws secretsmanager get-secret-value \
                      --secret-id "clinic/grafana-password-dev" \
                      --query SecretString --output text | jq -r .password)

                    umask 077
                    MONITORING_FILE=$(mktemp /tmp/monitoring-secrets-XXXXXX.yaml)
                    trap 'rm -f "$MONITORING_FILE"' EXIT

                    cat > "$MONITORING_FILE" <<EOF
grafana:
  adminPassword: "${GRAFANA_PASSWORD}"
EOF

                    helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
                    helm repo update

                    helm upgrade --install monitoring prometheus-community/kube-prometheus-stack \
                      -f ./helm/monitoring/values.yaml \
                      -f ./helm/monitoring/values-dev.yaml \
                      -f "$MONITORING_FILE" \
                      --namespace monitoring \
                      --create-namespace \
                      --timeout 5m

                    unset GRAFANA_PASSWORD
                '''
            }
        }

        stage('Deploy clinic') {
            steps {
                sh '''
                    set -euo pipefail
                    export KUBECONFIG=/var/lib/jenkins/.kube/config

                    DB_SECRET_JSON=$(aws secretsmanager get-secret-value \
                      --secret-id "clinic/db-credentials-dev" \
                      --query SecretString --output text)

                    DB_USER=$(echo "$DB_SECRET_JSON" | jq -r .username)
                    DB_PASSWORD=$(echo "$DB_SECRET_JSON" | jq -r .password)
                    DB_NAME=$(echo "$DB_SECRET_JSON" | jq -r .dbname)

                    DJANGO_SECRET_KEY=$(aws secretsmanager get-secret-value \
                      --secret-id "clinic/django-secret-key-dev" \
                      --query SecretString --output text)

                    EFS_ID=$(aws efs describe-file-systems \
                      --query "FileSystems[?Tags[?Key=='Name' && Value=='dev-clinic-media']].FileSystemId" \
                      --output text)

                    umask 077
                    VALUES_FILE=$(mktemp /tmp/clinic-secrets-XXXXXX.yaml)
                    trap 'rm -f "$VALUES_FILE"' EXIT

                    cat > "$VALUES_FILE" <<EOF
database:
  user: "${DB_USER}"
  password: "${DB_PASSWORD}"
  name: "${DB_NAME}"
django:
  secretKey: "${DJANGO_SECRET_KEY}"
efs:
  fileSystemId: "${EFS_ID}"
image:
  tag: "web-${IMAGE_TAG}"
nginx:
  image:
    tag: "nginx-${IMAGE_TAG}"
EOF

                    helm upgrade --install clinic ./helm/clinic \
                      -f ./helm/clinic/values.yaml \
                      -f ./helm/clinic/values-dev.yaml \
                      -f "$VALUES_FILE" \
                      --namespace dev \
                      --create-namespace

                    unset DB_USER DB_PASSWORD DB_NAME DJANGO_SECRET_KEY DB_SECRET_JSON
                '''
            }
        }
    }
}