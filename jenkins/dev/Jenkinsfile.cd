pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Image tag to deploy')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Deploy to dev') {
            steps {
                sh '''
                    set -euo pipefail

                    DB_SECRET_JSON=$(aws secretsmanager get-secret-value \
                      --secret-id "clinic/db-credentials-dev" \
                      --query SecretString --output text)

                    DB_USER=$(echo "$DB_SECRET_JSON" | jq -r .username)
                    DB_PASSWORD=$(echo "$DB_SECRET_JSON" | jq -r .password)
                    DB_NAME=$(echo "$DB_SECRET_JSON" | jq -r .dbname)

                    DJANGO_SECRET_KEY=$(aws secretsmanager get-secret-value \
                      --secret-id "clinic/django-secret-key-dev" \
                      --query SecretString --output text)

                    EFS_ID=$(aws efs describe-file-systems \
                      --query "FileSystems[?Tags[?Key=='Name' && Value=='dev-clinic-media']].FileSystemId" \
                      --output text)

                    umask 077
                    VALUES_FILE=$(mktemp /tmp/clinic-secrets-XXXXXX.yaml)
                    trap 'rm -f "$VALUES_FILE"' EXIT

                    cat > "$VALUES_FILE" <<EOF
database:
  user: "${DB_USER}"
  password: "${DB_PASSWORD}"
  name: "${DB_NAME}"
django:
  secretKey: "${DJANGO_SECRET_KEY}"
efs:
  fileSystemId: "${EFS_ID}"
image:
  tag: "${IMAGE_TAG}"
nginx:
  image:
    tag: "${IMAGE_TAG}"
EOF

                    helm upgrade --install clinic ./helm/clinic \
                      -f ./helm/clinic/values.yaml \
                      -f ./helm/clinic/values-dev.yaml \
                      -f "$VALUES_FILE" \
                      --namespace dev \
                      --create-namespace

                    unset DB_USER DB_PASSWORD DB_NAME DJANGO_SECRET_KEY DB_SECRET_JSON
                '''
            }
        }
    }
}