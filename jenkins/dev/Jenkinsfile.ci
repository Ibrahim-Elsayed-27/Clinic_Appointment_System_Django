pipeline {
    agent any

    environment {
        AWS_REGION   = 'us-east-1'
        ECR_REGISTRY = '123456789012.dkr.ecr.us-east-1.amazonaws.com'
        ECR_REPO     = 'clinic'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('ECR login') {
            steps {
                sh '''
                    aws ecr get-login-password --region "$AWS_REGION" \
                      | docker login --username AWS --password-stdin "$ECR_REGISTRY"
                '''
            }
        }

        stage('Build and push web image') {
            steps {
                sh '''
                    docker build -t "$ECR_REGISTRY/$ECR_REPO-web:$BUILD_NUMBER" -f app/Dockerfile app
                    docker push "$ECR_REGISTRY/$ECR_REPO-web:$BUILD_NUMBER"
                '''
            }
        }

        stage('Build and push nginx image') {
            steps {
                sh '''
                    docker build \
                      --build-arg WEB_IMAGE="$ECR_REGISTRY/$ECR_REPO-web:$BUILD_NUMBER" \
                      -t "$ECR_REGISTRY/$ECR_REPO-nginx:$BUILD_NUMBER" \
                      -f app/nginx/Dockerfile app/nginx
                    docker push "$ECR_REGISTRY/$ECR_REPO-nginx:$BUILD_NUMBER"
                '''
            }
        }

        stage('Trigger dev CD') {
            steps {
                build job: 'clinic-cd', parameters: [
                    string(name: 'IMAGE_TAG', value: "$BUILD_NUMBER")
                ]
            }
        }
    }
}