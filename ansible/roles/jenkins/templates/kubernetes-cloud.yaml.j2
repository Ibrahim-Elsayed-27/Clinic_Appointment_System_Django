jenkins:
  clouds:
    - kubernetes:
        name: "eks-cloud"
        serverUrl: "{{ eks_endpoint }}"
        namespace: "jenkins"
        credentialsId: "eks-cloud-kubeconfig"
        serverCertificate: |
{{ (eks_ca_data | b64decode) | indent(10, true) }}
        jenkinsUrl: "http://{{ jenkins_private_ip }}:8080"
        connectTimeout: 5
        readTimeout: 15
        containerCapStr: "10"
        podLabels:
          - key: "jenkins"
            value: "slave"
        templates:
          - name: "jenkins-agent"
            namespace: "jenkins"
            serviceAccount: "jenkins-agent"
            nodeUsageMode: NORMAL
            containers:
              - name: "jnlp"
                image: "jenkins/inbound-agent:latest"
                resourceRequestCpu: "500m"
                resourceRequestMemory: "512Mi"
                resourceLimitCpu: "1"
                resourceLimitMemory: "1Gi"